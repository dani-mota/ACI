# ── Database ─────────────────────────────────────────
DATABASE_URL="postgresql://..."
# Optional: Direct connection URL (bypasses connection pooler)
# DIRECT_URL="postgresql://..."

# ── Supabase Auth ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── AI (Anthropic) ──────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ── App URL (required — no fallback) ─────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── ElevenLabs TTS (optional — falls back to browser SpeechSynthesis) ──
# ELEVENLABS_API_KEY="..."
# ELEVENLABS_VOICE_ID="..."

# ── Email (Resend) ──────────────────────────────────
# RESEND_API_KEY="re_..."
# EMAIL_FROM="ACI Assessments <assessments@arklight.io>"
# SMTP_USER="..."
# SMTP_PASS="..."

# ── Cron / Webhooks ─────────────────────────────────
# CRON_SECRET="..."
# SCORING_FAILURE_WEBHOOK_URL="https://..."

# ── Admin / Monitoring ──────────────────────────────
# HEALTH_SECRET="..." (Bearer token for /api/admin/health)
# NEXT_PUBLIC_SENTRY_DSN="https://..."

# ── Rate Limiting (optional — falls back to in-memory) ──
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# ── Feature Flags ───────────────────────────────────
# V2 conversational assessment engine (existing V1 assessments unaffected)
ASSESSMENT_V2="false"
# Cheap local testing — Haiku model + 1 eval run (~20x cheaper)
ASSESSMENT_TEST_MODE="false"
# Content library for reference cards
FEATURE_CONTENT_LIBRARY="false"
# Few-shot examples in classification prompts
FEATURE_CLASSIFICATION_FEW_SHOT="true"
# Session binding — binds assessment to single browser session (prevents proxy test-taking)
ENABLE_SESSION_BINDING="false"
