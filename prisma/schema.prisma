generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// ORGANIZATION & USERS
// ──────────────────────────────────────────────

model Organization {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  domain          String?
  isDemo          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  users           User[]
  candidates      Candidate[]
  roles           Role[]
  cutlines        Cutline[]
  teamInvitations TeamInvitation[]
  // PRO-135: org-scoped role demand profiles for the Construct Map overlay.
  roleDemandProfiles RoleDemandProfile[]
}

model User {
  id          String                @id @default(cuid())
  supabaseId  String?               @unique
  email       String                @unique
  name        String
  role        UserRole
  // PRO-133: optional Employee Mode role assigned alongside Candidate Mode `role`.
  // Additive: a user can hold both (e.g., TA_LEADER + HR_TALENT_LEADER for an
  // org admin who also runs talent development). EMPLOYEE/PEOPLE_MANAGER
  // self-view + scoping ship in PRO-133 PR#2 (gated on Candidate.userId +
  // User.managerId additions).
  employeeRole EmployeeUserRole?
  // PRO-133 PR#2: nullable self-FK for PEOPLE_MANAGER direct-report scoping.
  // A User points at their manager via this column; PEOPLE_MANAGER queries
  // filter by `User.managerId === session.user.id` to find direct reports.
  // Single-hop only (no recursive team tree).
  managerId    String?
  manager      User?                 @relation("UserManager", fields: [managerId], references: [id])
  directReports User[]               @relation("UserManager")
  orgId       String
  org         Organization          @relation(fields: [orgId], references: [id])
  isActive         Boolean               @default(true)
  notes            Note[]
  invitations      AssessmentInvitation[]
  recordedOutcomes     OutcomeRecord[]
  teamInvitesSent      TeamInvitation[]       @relation("TeamInvitesSent")
  candidateAssignments CandidateAssignment[]
  assessmentsConverted Assessment[]           @relation("AssessmentConverter")
  // PRO-135: profiles authored by this user.
  roleDemandProfilesCreated RoleDemandProfile[] @relation("RoleDemandProfileAuthor")
  // PRO-133 PR#2: back-relation. When a Candidate has been converted to an
  // Employee and lazy-linked to this User account (User.email matched
  // Candidate.email at conversion time), this populates.
  linkedCandidate Candidate?            @relation("CandidateUser")
  createdAt            DateTime              @default(now())

  @@index([managerId])
}

enum UserRole {
  EXTERNAL_COLLABORATOR
  RECRUITER_COORDINATOR
  RECRUITING_MANAGER
  HIRING_MANAGER
  TA_LEADER
  ADMIN
}

// PRO-133: Employee Mode roles (additive to UserRole). Two-enum approach
// chosen over extending UserRole so the type system rejects nonsensical
// combinations like `role=TA_LEADER + employeeRole=TA_LEADER`.
enum EmployeeUserRole {
  EMPLOYEE
  PEOPLE_MANAGER
  HR_TALENT_LEADER
  EXECUTIVE
}

model TeamInvitation {
  id         String       @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  email      String
  name       String?
  role       UserRole
  invitedBy  String
  inviter    User         @relation("TeamInvitesSent", fields: [invitedBy], references: [id])
  token      String       @unique @default(uuid())
  status     InviteStatus @default(PENDING)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  @@index([email, orgId])
  @@index([token])
  @@index([orgId, status])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ──────────────────────────────────────────────
// ROLES & CUTLINES
// ──────────────────────────────────────────────

model Role {
  id                 String                @id @default(cuid())
  name               String
  slug               String
  description        String?
  orgId              String
  org                Organization          @relation(fields: [orgId], references: [id])
  cutlines           Cutline[]
  compositeWeights   CompositeWeight[]
  candidates         Candidate[]
  invitations        AssessmentInvitation[]
  contentLibraries   ContentLibrary[]
  createdAt          DateTime              @default(now())
  // Role Builder fields
  isCustom           Boolean               @default(false)
  complexityLevel    ComplexityLevel?
  sourceType         RoleSourceType?
  jobDescriptionText String?
  onetCodes          String[]
  researchRationale  Json?
  confidenceScores   Json?
  hiringIntelligence Json?
  jdContext          Json?
  isGeneric          Boolean               @default(false)
  createdBy          String?
  versions           RoleVersion[]

  @@unique([slug, orgId])
}

model Cutline {
  id                  String       @id @default(cuid())
  roleId              String
  role                Role         @relation(fields: [roleId], references: [id])
  orgId               String
  org                 Organization @relation(fields: [orgId], references: [id])
  technicalAptitude   Int
  behavioralIntegrity Int
  learningVelocity    Int
  overallMinimum      Int?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([roleId, orgId])
}

model CompositeWeight {
  id            String       @id @default(cuid())
  roleId        String
  role          Role         @relation(fields: [roleId], references: [id])
  constructId   String
  weight        Float
  version       Int          @default(1)
  source        WeightSource @default(RESEARCH_VALIDATED)
  effectiveFrom DateTime     @default(now())
  effectiveTo   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([roleId, constructId, version])
}

enum WeightSource {
  RESEARCH_VALIDATED
  EMPIRICALLY_ADJUSTED
  CLIENT_CUSTOMIZED
}

model ContentLibrary {
  id                    String               @id @default(cuid())
  roleId                String
  role                  Role                 @relation(fields: [roleId], references: [id])
  version               Int                  @default(1)
  status                ContentLibraryStatus @default(GENERATING)
  content               Json                 // Full pre-generated content tree
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  errorLog              Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@unique([roleId, version])
  @@index([roleId, status])
}

enum ContentLibraryStatus {
  GENERATING
  READY
  FAILED
  DEPRECATED
}

model RoleVersion {
  id            String   @id @default(cuid())
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  versionNumber Int
  weights       Json
  cutlines      Json
  rationale     Json?
  changedBy     String
  changeNote    String?
  createdAt     DateTime @default(now())

  @@unique([roleId, versionNumber])
  @@index([roleId])
}

enum ComplexityLevel {
  LOW
  MEDIUM
  MEDIUM_HIGH
  HIGH
}

enum RoleSourceType {
  SYSTEM_DEFAULT
  JD_UPLOAD
  TEMPLATE_CLONE
  MANUAL_ENTRY
}

// ──────────────────────────────────────────────
// CANDIDATES & ASSESSMENTS
// ──────────────────────────────────────────────

model Candidate {
  id            String                @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  orgId         String
  org           Organization          @relation(fields: [orgId], references: [id])
  primaryRoleId String
  primaryRole   Role                  @relation(fields: [primaryRoleId], references: [id])
  status        CandidateStatus       @default(INCOMPLETE)
  assessment    Assessment?
  invitations   AssessmentInvitation[]
  notes         Note[]
  outcomes      OutcomeRecord[]
  assignments   CandidateAssignment[]
  // PRO-133 PR#2: nullable FK to User. Populated at conversion time IF a
  // User exists with matching email + orgId (lazy email-match). Stays null
  // for external hires until PRO-182 ships auto-create-User-on-convert.
  // Unique because one Candidate maps to at most one User account.
  userId        String?               @unique
  user          User?                 @relation("CandidateUser", fields: [userId], references: [id])
  resultsEmailSentAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([email, orgId])
}

model CandidateAssignment {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt  DateTime  @default(now())

  @@unique([candidateId, userId])
  @@index([userId])
  @@index([candidateId])
}

enum CandidateStatus {
  INVITED
  INCOMPLETE
  SCORING
  RECOMMENDED
  REVIEW_REQUIRED
  DO_NOT_ADVANCE
  HIRED
  ERROR
}

enum AssessmentMode {
  CANDIDATE
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  REASSESSMENT_DUE
  IN_TRANSITION
}

model Assessment {
  id              String              @id @default(cuid())
  candidateId     String              @unique
  candidate       Candidate           @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentMode  AssessmentMode      @default(CANDIDATE)
  // PRO-127: employee conversion fields (set when assessmentMode flips to EMPLOYEE)
  department      String?
  roleFamily      String?
  convertedAt     DateTime?
  convertedBy     String?
  converter       User?               @relation("AssessmentConverter", fields: [convertedBy], references: [id])
  // PRO-129: employee lifecycle status (only meaningful when assessmentMode = EMPLOYEE)
  employeeStatus  EmployeeStatus?
  // PRO-130: Cognitive Signature (Layer 1) — cached AI-generated narrative
  // We deliberately store ONLY successful AI output. Failed Haiku attempts bump
  // cognitiveSignatureAttemptedAt (cooldown gate) without polluting the cache with fallback text.
  cognitiveSignature              String?
  cognitiveSignaturePromptVersion Int      @default(1)
  cognitiveSignatureAttemptedAt   DateTime?
  startedAt       DateTime
  completedAt     DateTime?
  durationMinutes Int?
  subtestResults  SubtestResult[]
  compositeScores CompositeScore[]
  predictions     Prediction?
  redFlags        RedFlag[]
  aiInteractions  AIInteraction[]
  itemResponses   ItemResponse[]
  survey          PostAssessmentSurvey?
  // V2 conversational assessment relations
  messages          ConversationMessage[]
  assessmentState   AssessmentState?
  aiEvaluationRuns  AIEvaluationRun[]
  // PRO-132: per-construct evidence annotations (lazy-generated on dossier expand)
  evidenceAnnotations EvidenceAnnotation[]
  // PRO-137: derived employee insights (under-leverage score + future siblings).
  // Optional 1:1 — only present once the row has been touched by conversion,
  // profile save, or a dossier read (lazy population).
  insights        EmployeeInsights?
  // Cost tracking
  scoringCostUsd    Float?
  scoringTokensIn   Int?
  scoringTokensOut  Int?
  createdAt       DateTime            @default(now())
}

// ──────────────────────────────────────────────
// CONSTRUCT SCORES
// ──────────────────────────────────────────────

model SubtestResult {
  id                String          @id @default(cuid())
  assessmentId      String
  assessment        Assessment      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  construct         Construct
  layer             Layer
  rawScore          Float
  percentile        Int
  theta             Float?
  standardError     Float?
  responseTimeAvgMs Int?
  itemCount         Int
  aiFollowUpCount   Int             @default(0)
  calibrationScore  Float?
  calibrationBias   String?
  narrativeInsight  String?
  // V2 layered scoring fields
  layerARawScore          Float?
  layerBRawScore          Float?
  layerAWeight            Float?
  layerBWeight            Float?
  consistencyLevel        String?           // "HIGH" or "LOW"
  consistencyDownweighted Boolean           @default(false)
  ceilingType             CeilingTypeEnum?
  ceilingNarrative        String?
  scoringVersion          Int               @default(1)
  createdAt         DateTime        @default(now())

  @@unique([assessmentId, construct])
}

enum Layer {
  COGNITIVE_CORE
  TECHNICAL_APTITUDE
  BEHAVIORAL_INTEGRITY
}

enum Construct {
  FLUID_REASONING
  EXECUTIVE_CONTROL
  COGNITIVE_FLEXIBILITY
  METACOGNITIVE_CALIBRATION
  LEARNING_VELOCITY
  SYSTEMS_DIAGNOSTICS
  PATTERN_RECOGNITION
  QUANTITATIVE_REASONING
  SPATIAL_VISUALIZATION
  MECHANICAL_REASONING
  PROCEDURAL_RELIABILITY
  ETHICAL_JUDGMENT
}

model CompositeScore {
  id                  String     @id @default(cuid())
  assessmentId        String
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  roleSlug            String
  indexName            String
  score               Float
  percentile          Int
  passed              Boolean
  distanceFromCutline Float
  createdAt           DateTime   @default(now())

  @@unique([assessmentId, roleSlug])
}

// ──────────────────────────────────────────────
// AI-ADAPTIVE INTERACTIONS
// ──────────────────────────────────────────────

model AIInteraction {
  id                String     @id @default(cuid())
  assessmentId      String
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  construct         Construct
  sequenceOrder     Int
  triggerItemId     String?
  triggerResponse   String?
  aiPrompt          String
  candidateResponse String?
  responseTimeMs    Int?
  aiAnalysis        String?
  evidenceFor       Json?
  confidenceLevel   Float?
  createdAt         DateTime   @default(now())

  @@index([assessmentId, construct])
}

// ──────────────────────────────────────────────
// PREDICTIONS & FLAGS
// ──────────────────────────────────────────────

model Prediction {
  id                  String           @id @default(cuid())
  assessmentId        String           @unique
  assessment          Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  rampTimeMonths      Float
  rampTimeLabel       String
  rampTimeFactors     Json
  supervisionLoad     SupervisionLevel
  supervisionScore    Int
  supervisionFactors  Json
  performanceCeiling  CeilingLevel
  ceilingFactors      Json
  ceilingCareerPath   Json
  attritionRisk       RiskLevel
  attritionFactors    Json
  attritionStrategies Json
  archivedAt          DateTime?        // PRO-127: set on conversion to EMPLOYEE mode
  createdAt           DateTime         @default(now())
}

enum SupervisionLevel {
  LOW
  MEDIUM
  HIGH
}

enum CeilingLevel {
  HIGH
  MEDIUM
  LOW
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model RedFlag {
  id           String       @id @default(cuid())
  assessmentId String
  assessment   Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  severity     FlagSeverity
  category     String
  title        String
  description  String
  constructs   String[]
  archivedAt   DateTime?    // PRO-127: set on conversion to EMPLOYEE mode
  createdAt    DateTime     @default(now())
}

enum FlagSeverity {
  CRITICAL
  WARNING
  INFO
}

// ──────────────────────────────────────────────
// NOTES & AUDIT
// ──────────────────────────────────────────────

model Note {
  id          String    @id @default(cuid())
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  content     String
  // PRO-133: per-row author-private flag. When true, only the author can
  // read the note (enforced server-side via `canViewManagerNotes`). When
  // false (default — backwards compatible with existing notes), public
  // notes follow `canViewAnyEmployee`.
  //
  // PROD-DEPLOY GATE: re-run the Note table audit against production
  // before this migration runs in prod. If any prod note contains
  // sensitive content, ship a follow-up migration flipping the default
  // to true before the column-add migration lands. Don't merge to prod
  // without that audit. Dev-DB audit 2026-05-04 found 25 rows of benign
  // TA_LEADER operational text only.
  isPrivate   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ──────────────────────────────────────────────
// ASSESSMENT INVITATIONS
// ──────────────────────────────────────────────

model AssessmentInvitation {
  id            String           @id @default(cuid())
  candidateId   String
  candidate     Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  roleId        String
  role          Role             @relation(fields: [roleId], references: [id])
  invitedBy     String
  inviter       User             @relation(fields: [invitedBy], references: [id])
  invitedAt     DateTime         @default(now())
  expiresAt     DateTime
  status        InvitationStatus @default(PENDING)
  linkToken     String           @unique @default(cuid())
  emailSentAt   DateTime?
  linkOpenedAt  DateTime?
  reminderCount    Int              @default(0)
  sessionBindingId String?
  createdAt        DateTime         @default(now())

  @@index([candidateId])
}

enum InvitationStatus {
  PENDING
  STARTED
  COMPLETED
  EXPIRED
}

// ──────────────────────────────────────────────
// ITEM RESPONSES & SURVEY
// ──────────────────────────────────────────────

model ItemResponse {
  id                      String         @id @default(cuid())
  assessmentId            String
  assessment              Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  itemId                  String
  itemType                ItemType
  response                String
  clientResponseTimeMs    Int?           @map("responseTimeMs") // PRO-114: renamed from responseTimeMs
  serverSideResponseTimeMs Int?          // PRO-114: authoritative server-computed timing
  confidence              Float?
  rawScore                Float?
  // V2 fields
  act            AssessmentAct?
  // Fix: PRO-83 — add FK constraint for messageId
  messageId      String?          // Links to ConversationMessage if from V2 chat
  message        ConversationMessage? @relation(fields: [messageId], references: [id])
  createdAt      DateTime       @default(now())

  @@unique([assessmentId, itemId])
}

enum ItemType {
  MULTIPLE_CHOICE
  LIKERT
  OPEN_RESPONSE
  AI_PROBE
  TIMED_SEQUENCE
}

// ──────────────────────────────────────────────
// V2 CONVERSATIONAL ASSESSMENT ENUMS
// ──────────────────────────────────────────────

enum AssessmentAct {
  PHASE_0
  ACT_1
  ACT_2
  ACT_3
}

enum CeilingTypeEnum {
  HARD_CEILING
  SOFT_CEILING_TRAINABLE
  SOFT_CEILING_CONTEXT_DEPENDENT
  STRESS_INDUCED
  INSUFFICIENT_DATA
}

enum ConvoMessageRole {
  AGENT
  CANDIDATE
  SYSTEM
}

enum InteractionElementType {
  TEXT_RESPONSE
  MULTIPLE_CHOICE_INLINE
  NUMERIC_INPUT
  TIMED_CHALLENGE
  CONFIDENCE_RATING
  TRADEOFF_SELECTION
}

model PostAssessmentSurvey {
  id           String     @id @default(cuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  difficulty   Int
  fairness     Int
  faceValidity Int
  openFeedback String?
  createdAt    DateTime   @default(now())
}

// ──────────────────────────────────────────────
// DATA REFINEMENT
// ──────────────────────────────────────────────

model OutcomeRecord {
  id          String        @id @default(cuid())
  candidateId String
  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  metricType  OutcomeMetric
  metricValue Float
  notes       String?
  recordedBy  String
  recorder    User          @relation(fields: [recordedBy], references: [id])
  observedAt  DateTime
  createdAt   DateTime      @default(now())

  @@index([candidateId])
  @@index([metricType])
}

enum OutcomeMetric {
  TRAINING_COMPLETION_DAYS
  RAMP_TIME_MONTHS
  NINETY_DAY_RETENTION
  SUPERVISOR_RATING
  QUALITY_SCORE
  SAFETY_INCIDENT
  TRAINING_TEST_SCORE
  PROMOTION
}

model ItemCalibration {
  id             String    @id @default(cuid())
  itemId         String
  construct      Construct
  version        Int
  difficulty     Float
  discrimination Float
  guessing       Float
  sampleSize     Int
  fitStatistic   Float?
  flagged        Boolean   @default(false)
  flagReason     String?
  calibratedAt   DateTime
  createdAt      DateTime  @default(now())

  @@unique([itemId, version])
  @@index([construct])
  @@index([flagged])
}

// ──────────────────────────────────────────────
// V2 CONVERSATIONAL ASSESSMENT
// ──────────────────────────────────────────────

model ConversationMessage {
  id              String                  @id @default(cuid())
  assessmentId    String
  assessment      Assessment              @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  role            ConvoMessageRole
  content         String
  act             AssessmentAct
  metadata        Json?                   // Beat number, scenario index, construct signals, etc.
  elementType     InteractionElementType?
  elementData     Json?                   // Options, correct answer, timer config, etc.
  candidateInput      String?                 // Candidate's structured response to an interactive element
  responseTimeMs      Int?
  questionDeliveredAt DateTime?               // PRO-114: server timestamp when interactive element was dispatched
  sequenceOrder       Int
  idempotencyKey  String?                 @unique // Fix: PRO-31 — deduplication key for client retries
  // Fix: PRO-83 — back-relation for ItemResponse.messageId FK
  itemResponses   ItemResponse[]
  // PRO-132 back-relation: a message can be the evidence source for one or more construct annotations
  evidenceAnnotations EvidenceAnnotation[]
  createdAt       DateTime                @default(now())

  @@index([assessmentId, act])
  @@index([assessmentId, sequenceOrder])
  @@unique([assessmentId, sequenceOrder])
}

model AssessmentState {
  id                String        @id @default(cuid())
  assessmentId      String        @unique
  assessment        Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  currentAct        AssessmentAct @default(ACT_1)
  currentScenario   Int           @default(0)
  currentBeat       Int           @default(0)
  currentConstruct  String?
  currentPhase      Int?
  branchPath        Json?
  act2Progress      Json?
  act3Progress      Json?
  contentLibraryId  String?       // Snapshot: which content library version this assessment uses
  variantSelections Json?         // { scenarioId: variantIndex } random selection per scenario
  phase0Complete    Boolean       @default(false)
  isComplete        Boolean       @default(false)
  realtimeTokensIn  Int           @default(0)
  realtimeTokensOut Int           @default(0)
  act1CompletedAt   DateTime?
  act2CompletedAt   DateTime?
  act3CompletedAt   DateTime?
  updatedAt         DateTime      @updatedAt
  createdAt         DateTime      @default(now())
}

model AIEvaluationRun {
  id              String     @id @default(cuid())
  assessmentId    String
  assessment      Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  messageId       String
  construct       Construct
  runIndex        Int
  indicatorScores Json
  aggregateScore  Float
  modelId         String
  latencyMs       Int
  rawOutput       String
  createdAt       DateTime   @default(now())

  @@index([assessmentId, construct])
  @@index([messageId])
  @@unique([assessmentId, messageId, construct, runIndex])
}

// ──────────────────────────────────────────────
// EVIDENCE LAYER (PRO-132)
// ──────────────────────────────────────────────
// Per-construct cached annotation linked to a real candidate message.
// Lazy-generated when a manager expands a construct row in the dossier.
// Only successful AI output is stored; failed Haiku attempts bump
// attemptedAt (cooldown gate) without polluting the cache with fallback text.

model EvidenceAnnotation {
  id            String              @id @default(cuid())
  assessmentId  String
  assessment    Assessment          @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  construct     Construct
  // The ConversationMessage chosen as evidence; content is read at render time.
  messageId     String
  message       ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  // 1-sentence developmental-framing annotation. Null if generation has not been attempted.
  annotation    String?
  // Bumped by PRO-134; mismatches force regeneration on next expand.
  promptVersion Int                 @default(1)
  // Last Haiku attempt timestamp; gates retries during cooldown after failures.
  attemptedAt   DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([assessmentId, construct])
  @@index([assessmentId])
}

// ──────────────────────────────────────────────
// EMPLOYEE INSIGHTS (PRO-137 → PRO-139)
// ──────────────────────────────────────────────
// Per-employee derived scores. Sibling Int? columns get added by PRO-138
// (Trajectory Readiness) and PRO-139 (Fit Panels). Single row per assessment
// so multiple insights co-locate without each ticket adding its own table.
//
// orgId + roleFamily are denormalized from Assessment.candidate.orgId and
// Assessment.roleFamily — the duplication avoids a 3-table JOIN inside the
// batch-invalidation UPDATE that PRO-137 runs on role-demand profile save.
// (Prisma can't compose multi-table UPDATEs cleanly; Postgres can't index
// across tables.)
//
// profileId + profileUpdatedAt are the staleness signal: PRO-135's
// ResolvedRoleDemand carries the same pair, so lazy-on-read checks
// equality and recomputes if mismatched. Set to NULL on profile save to
// force the next dossier read to recompute.

model EmployeeInsights {
  id                  String     @id @default(cuid())
  assessmentId        String     @unique
  assessment          Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // PRO-137: under-leverage score (0-100). Null when no resolvable
  // role-demand profile, or insufficient SubtestResult data.
  underLeverageScore  Int?

  // Denormalized for batch invalidation. See header comment.
  orgId               String
  roleFamily          String?

  // Staleness signal (compared against ResolvedRoleDemand on dossier read).
  // NULL after profile save = forces lazy recompute on next read.
  profileId           String?
  profileUpdatedAt    DateTime?

  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([orgId, roleFamily])             // batch invalidation hot path
  @@index([orgId, underLeverageScore])     // list sort hot path
}

// ──────────────────────────────────────────────
// ACT 2 ITEM ANSWERS (PRO-66)
// ──────────────────────────────────────────────

model Act2ItemAnswer {
  id            String   @id @default(cuid())
  itemId        String   @unique
  correctAnswer String
  createdAt     DateTime @default(now())
}

// ──────────────────────────────────────────────
// ROLE DEMAND PROFILES (PRO-135)
// ──────────────────────────────────────────────

model RoleDemandProfile {
  id          String   @id @default(cuid())
  // Display name. e.g., "Software Engineer — IC3"
  name        String
  // Matches Assessment.roleFamily; resolved case-insensitively at the data layer
  // (Prisma `mode: "insensitive"`). The migration adds a functional partial
  // index on (orgId, LOWER(roleFamily)) WHERE isTemplate = false to keep that
  // resolution from degrading to a sequential scan as profile counts grow.
  roleFamily  String
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  // JSON because the 12 construct keys are fixed and we always read/write the
  // whole map at once. Normalized rows would force per-construct upserts on
  // save and a JOIN on every overlay read with no querying-by-value benefit.
  // Shape changes (new constructs) won't require migrations. Stored 1-10
  // (authoring scale); the radar overlay reads it via a single resolver that
  // converts to 0-100.
  constructScores Json

  isTemplate  Boolean  @default(false)
  createdById String
  createdBy   User     @relation("RoleDemandProfileAuthor", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId, roleFamily])
  // The functional partial index on (orgId, LOWER(roleFamily)) WHERE
  // isTemplate = false is created in the migration directly — Prisma can't
  // express LOWER() expressions in @@index. See PRO-135 migration SQL.
}
